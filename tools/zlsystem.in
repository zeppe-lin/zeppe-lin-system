from pathlib import Path
import sys

SOURCE_ROOT = Path(r'@SOURCE_ROOT@')
CONTROLLER_SOURCE_LOCK = r'@CONTROLLER_SOURCE_LOCK@'
sys.path.insert(0, str(SOURCE_ROOT))

from zlsystem.cli import main
from zlsystem.model import BuildContext

raise SystemExit(main(BuildContext(
    source_root=SOURCE_ROOT,
    build_root=Path(r'@BUILD_ROOT@'),
    pkgctl=Path(r'@PKGCTL@'),
    pkgstate_init=Path(r'@PKGSTATE_INIT@'),
    git=Path(r'@GIT@'),
    readelf=Path(r'@READELF@'),
    controller_source_lock=CONTROLLER_SOURCE_LOCK,
)))
